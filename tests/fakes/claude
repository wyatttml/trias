#!/bin/bash
# 假验收模型。亲修提示词（「亲自接手」）：写交付说明、改回「待验收」。验收提示词按 FAKE_SCENARIO：
#   happy：S2 第一次判返工，其余通过并留遗留项；decide：判需决定、可自动、推荐通过；
#   passfirst：第一次判通过（程序结果其实没过），之后一直判返工。
prompt="${@: -1}"
if echo "$prompt" | grep -q '亲自接手'; then
  stage="$(echo "$prompt" | grep -oE 'S[0-9]+[a-z]*' | head -1)"
  echo "fix $stage" >> "$PWD/claude_calls.txt"; echo "亲修 $stage" > "$PWD/验收证据/$stage/交付说明.md"
  STATE_FILE="$PWD/项目状态.md" python3 "$PWD/pipeline/state.py" set "$stage" 待验收 >/dev/null; echo "fake claude: fix $stage"; exit 0
fi
stage="$(echo "$prompt" | grep -oE '验收 S[0-9]+[a-z]*' | head -1 | grep -oE 'S[0-9]+[a-z]*')"
echo "accept $stage" >> "$PWD/claude_calls.txt"
f="$PWD/验收证据/$stage/验收结论.md"; c="$PWD/运行数据/pipeline/fake_count_$stage"
n=$(( $(cat "$c" 2>/dev/null || echo 0) + 1 )); echo $n > "$c"
case "${FAKE_SCENARIO:-happy}" in
  decide) printf '结论：需决定\n## 需决定\n要不要放宽上限\n选项 A 放宽\n选项 B 不放\n可自动按推荐：是\n推荐决定：通过\n## 给 AI 产品经理的一句话摘要\n需要你定一下\n' > "$f";;
  passfirst) if [ "$n" = 1 ]; then printf '结论：通过\n## 给 AI 产品经理的一句话摘要\n看着都好\n' > "$f"
             else printf '结论：返工\n## 问题清单\n- a 步失败：跑冒烟复现、期望 PASS\n## 调优清单\n- 样品一：开头太平，改提示词\n## 给 AI 产品经理的一句话摘要\n还没修好\n' > "$f"; fi;;
  *) if [ "$stage" = S2 ] && [ "$n" = 1 ]; then
       printf '结论：返工\n## 问题清单\n- 坏了：怎么复现、期望\n## 给 AI 产品经理的一句话摘要\n有个问题要修\n' > "$f"
     else
       printf '结论：通过\n## 遗留到下一阶段\n- %s 留下的小毛病\n## 给 AI 产品经理的一句话摘要\n%s 都好\n' "$stage" "$stage" > "$f"
     fi;;
esac
echo "fake claude: $stage round $n"
