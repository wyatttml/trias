#!/bin/bash
# 假执行模型：读 stdin 提示词，认出子阶段，写交付说明，把状态改成「待验收」。
root=""; while [ $# -gt 0 ]; do case "$1" in -C) root="$2"; shift;; esac; shift; done
prompt="$(cat)"; stage="$(echo "$prompt" | grep -oE 'S[0-9]+' | head -1)"
mkdir -p "$root/验收证据/$stage"; echo "做了 $stage" > "$root/验收证据/$stage/交付说明.md"
STATE_FILE="$root/项目状态.md" python3 "$root/pipeline/state.py" set "$stage" 待验收 >/dev/null
echo "fake codex: $stage done"
